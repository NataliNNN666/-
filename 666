import yfinance as yf
import pandas_ta as ta
import pandas as pd
import time
import telebot
from telebot import types
import mplfinance as mpf
from sklearn.ensemble import RandomForestClassifier
import os
import warnings
from threading import Thread

warnings.filterwarnings('ignore')

# --- КОНФИГУРАЦИЯ ---
TOKEN = '8796786650:AAEnu2bzpqvu3S78upEA3xKk95th3s0xWJA'
CHAT_ID = '6147800990'
ASSETS = {"GOLD": "GC=F", "EURUSD": "EURUSD=X", "BITCOIN": "BTC-USD"}
FEATURES = ['Close', 'RSI', 'MACD', 'STOCH_K', 'EMA_9', 'SMA_200', 'Hour', 'DayOfWeek']

# Настройки режимов
TRADING_MODES = {"🐢 Консерватор": 0.85, "⚖️ Умеренный": 0.70, "⚡️ Агрессор": 0.60}
current_mode = "⚖️ Умеренный"

# Баланс
balance = 1000.0
wins, losses = 0, 0
active_trades = {}
last_data = {}

bot = telebot.TeleBot(TOKEN)

# --- МЕНЮ ---
def main_menu():
    markup = types.ReplyKeyboardMarkup(resize_keyboard=True)
    markup.row(types.KeyboardButton("💡 Идея дня"), types.KeyboardButton("💰 Мой баланс"))
    markup.row(types.KeyboardButton("⚙️ Режим торговли"), types.KeyboardButton("⚙️ Статус"))
    return markup

@bot.message_handler(commands=['start'])
def send_welcome(message):
    bot.send_message(CHAT_ID, "🚀 ИИ-Сердце запущено! Выбирай режим и следи за сигналами.", reply_markup=main_menu())

@bot.message_handler(func=lambda m: True)
def handle_msg(m):
    global current_mode
    if m.text == "💰 Мой баланс":
        bot.send_message(CHAT_ID, f"💵 Баланс: ${balance:.2f}\n🏆 W: {wins} | ❌ L: {losses}")
    elif m.text == "⚙️ Статус":
        bot.send_message(CHAT_ID, f"🤖 Режим: {current_mode}\n📡 Активов в работе: {len(ASSETS)}")
    elif m.text == "⚙️ Режим торговли":
        markup = types.ReplyKeyboardMarkup(resize_keyboard=True)
        for mode in TRADING_MODES.keys(): markup.add(types.KeyboardButton(mode))
        markup.add(types.KeyboardButton("⬅️ Назад"))
        bot.send_message(CHAT_ID, "Выбери манеру торговли:", reply_markup=markup)
    elif m.text in TRADING_MODES:
        current_mode = m.text
        bot.send_message(CHAT_ID, f"✅ Режим изменен на: {current_mode}", reply_markup=main_menu())
    elif m.text == "⬅️ Назад":
        bot.send_message(CHAT_ID, "Возвращаемся...", reply_markup=main_menu())
    elif m.text == "💡 Идея дня":
        if last_data:
            best = max(last_data.items(), key=lambda x: x[1]['conf'])
            bot.send_message(CHAT_ID, f"🔍 Лучшая идея: {best[0]} ({best[1]['side']})\nУверенность: {best[1]['conf']:.1f}%")
        else: bot.send_message(CHAT_ID, "Анализирую... Попробуй через минуту.")

# --- ИИ ЛОГИКА ---
def train_ai(file):
    try:
        df = pd.read_csv(file).dropna(subset=FEATURES)
        if len(df) < 500: return None
        X, y = df[FEATURES], (df['Close'].shift(-1) > df['Close']).astype(int)
        return RandomForestClassifier(n_estimators=100, random_state=42).fit(X[:-1], y[:-1])
    except: return None

Thread(target=bot.infinity_polling).start()

# --- ЦИКЛ ---
while True:
    threshold = TRADING_MODES[current_mode]
    for name, ticker in ASSETS.items():
        try:
            mem = f"{name.lower()}_memory.csv"
            df = yf.download(ticker, period="59d", interval="5m", progress=False)
            if df.empty: continue
            if isinstance(df.columns, pd.MultiIndex): df.columns = df.columns.get_level_values(0)

            df['RSI'] = ta.rsi(df['Close'], length=14)
            df['EMA_9'] = ta.ema(df['Close'], length=9); df['SMA_200'] = ta.sma(df['Close'], length=200)
            m_a = ta.macd(df['Close']); s_t = ta.stoch(df['High'], df['Low'], df['Close'])
            if m_a is not None: df['MACD'] = m_a.iloc[:, 0]
            if s_t is not None: df['STOCH_K'] = s_t.iloc[:, 0]
            df['Hour'], df['DayOfWeek'] = df.index.hour, df.index.dayofweek
            
            df_c = df.dropna(subset=FEATURES); price = float(df_c.iloc[-1]['Close'])
            df_c[FEATURES + ['Close']].to_csv(mem, index=False)

            # Проверка сделки
            if name in active_trades:
                t = active_trades[name]; p = (price - t['p'])*100 if t['s']=="BUY" else (t['p'] - price)*100
                balance += p
                if p > 0: wins += 1
                else: losses += 1
                bot.send_message(CHAT_ID, f"{'✅' if p>0 else '❌'} {name} закрыт: ${p:.2f}\nБаланс: ${balance:.2f}")
                del active_trades[name]

            # Прогноз
            model = train_ai(mem)
            if model and name not in active_trades:
                probs = model.predict_proba(df_c.iloc[-1:][FEATURES])[0]
                side = "BUY" if probs[1] >= threshold else "SELL" if probs[0] >= threshold else ""
                last_data[name] = {'conf': max(probs)*100, 'side': side if side else "Нейтрально"}
                
                if side:
                    active_trades[name] = {'p': price, 's': side}
                    mpf.plot(df.tail(40), type='candle', style='charles', savefig='chart.png', 
                             addplot=[mpf.make_addplot(df.tail(40)['SMA_200'], color='red'), mpf.make_addplot(df.tail(40)['EMA_9'], color='blue')])
                    with open('chart.png', 'rb') as f:
                        bot.send_photo(CHAT_ID, f, caption=f"🔔 {name} {side}\nЦена: {price:.2f}\nУверенность: {max(probs)*100:.1f}%")
        except Exception as e: print(f"Ошибка {name}: {e}")
    time.sleep(300)
