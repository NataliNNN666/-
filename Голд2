import os
import time
from datetime import datetime, timedelta
from threading import Thread

# ================= CONFIG =================
TOKEN = "ВАШ_ТОКЕН"
CHAT_ID = "ВАШ_ID"
ACCOUNT = 12345678
PASSWORD = "ВАШ_ПАРОЛЬ"
SERVER = "ВАШ_СЕРВЕР"

SYMBOLS = {"GOLD": "XAUUSD", "EURUSD": "EURUSD"}
