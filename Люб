# ================= СИСТЕМА ИСПОЛНЕНИЯ =================

def get_filling_mode(symbol):
    s_info = mt5.symbol_info(symbol)
    if s_info.filling_mode & mt5.ORDER_FILLING_IOC: return mt5.ORDER_FILLING_IOC
    if s_info.filling_mode & mt5.ORDER_FILLING_FOK: return mt5.ORDER_FILLING_FOK
    return mt5.ORDER_FILLING_RETURN

def log_entry(symbol, side, ticket):
    data = {"ticket": ticket, "time": datetime.now(), "symbol": symbol, "side": side, "profit": "OPEN"}
    df = pd.DataFrame([data])
    df.to_csv(LOG_FILE, mode='a', header=not os.path.exists(LOG_FILE), index=False)

def send_chart(symbol, side, price):
    rates = mt5.copy_rates_from_pos(symbol, mt5.TIMEFRAME_M5, 0, 50)
    if rates is None: return
    df = pd.DataFrame(rates)
    plt.figure(figsize=(8, 4))
    plt.plot(df['close'], label='Price')
    plt.axhline(y=price, color=('g' if side == "BUY" else 'r'), ls='--')
    plt.title(f"SCALP {symbol} | {side}")
    path = f"chart_{symbol}.png"
    plt.savefig(path); plt.close()
    with open(path, 'rb') as f:
        bot.send_photo(CHAT_ID, f, caption=f"🚀 Сделка: {side} {symbol} по {price}")
    if os.path.exists(path): os.remove(path)

# ================= ТОРГОВЫЙ ДВИЖОК =================

def open_trade(symbol, side, atr):
    tick = mt5.symbol_info_tick(symbol)
    price = tick.ask if side == "BUY" else tick.bid
    sl = price - (atr * 1.5) if side == "BUY" else price + (atr * 1.5)
    tp = price + (atr * 2.0) if side == "BUY" else price - (atr * 2.0)

    request = {
        "action": mt5.TRADE_ACTION_DEAL,
        "symbol": symbol,
        "volume": LOT,
        "type": mt5.ORDER_TYPE_BUY if side == "BUY" else mt5.ORDER_TYPE_SELL,
        "price": price, "sl": sl, "tp": tp,
        "magic": MAGIC, "comment": "SCALP_FINAL",
        "type_filling": get_filling_mode(symbol),
        "type_time": mt5.ORDER_TIME_GTC,
    }
    res = mt5.order_send(request)
    if res.retcode == mt5.TRADE_RETCODE_DONE:
        send_chart(symbol, side, price)
        log_entry(symbol, side, res.order)
    else:
        print(f"Ошибка {symbol}: {res.comment}")

def trading_engine():
    if not mt5.initialize(): return
    mt5.login(ACCOUNT, PASSWORD, SERVER)
    
    while True:
        if trading_mode != 0:
            for _, symbol in SYMBOLS.items():
                try:
                    if mt5.positions_get(symbol=symbol): continue
                    
                    rates = mt5.copy_rates_from_pos(symbol, mt5.TIMEFRAME_M5, 0, 150)
                    if rates is None: continue
                    
                    df = pd.DataFrame(rates)
                    # Расчет индикаторов
                    bb = ta.bbands(df['close'], length=20, std=2)
                    stoch = ta.stoch(df['high'], df['low'], df['close'], k=5, d=3)
                    df['ATR'] = ta.atr(df['high'], df['low'], df['close'], length=14)
                    df = pd.concat([df, bb, stoch], axis=1).dropna()

                    # Универсальный поиск колонок (решает ошибку BBL_20_2.0)
                    bbl = df[[c for c in df.columns if c.startswith('BBL')]].iloc[-1].values[0]
                    bbu = df[[c for c in df.columns if c.startswith('BBU')]].iloc[-1].values[0]
                    k_line = df[[c for c in df.columns if c.startswith('STOCHk')]]
                    
                    last_k = k_line.iloc[-1].values[0]
                    prev_k = k_line.iloc[-2].values[0]
                    curr_close = df['close'].iloc[-1]
                    atr = df['ATR'].iloc[-1]

                    side = None
                    if curr_close < bbl and prev_k < 20 and last_k > 20:
                        side = "BUY"
                    elif curr_close > bbu and prev_k > 80 and last_k < 80:
                        side = "SELL"

                    if side:
                        if trading_mode == 2: open_trade(symbol, side, atr)
                        elif trading_mode == 1:
                            bot.send_message(CHAT_ID, f"🔍 СИГНАЛ {symbol}: {side}")
                            
                except Exception as e: print(f"Ошибка цикла {symbol}: {e}")
        time.sleep(30)

# ================= ИНТЕРФЕЙС ТЕЛЕГРАМ =================

@bot.message_handler(commands=['start'])
def welcome(m):
    kb = telebot.types.ReplyKeyboardMarkup(resize_keyboard=True)
    kb.row("📊 Позиции", "💰 Баланс")
    kb.row("⚙️ Режим", "⚠️ ЗАКРЫТЬ ВСЕ")
    bot.send_message(m.chat.id, f"🤖 Скальпер запущен\nРежим: {MODES[trading_mode]}", reply_markup=kb)

@bot.message_handler(func=lambda m: m.text == "💰 Баланс")
def balance(m):
    acc = mt5.account_info()
    if acc: bot.send_message(m.chat.id, f"💳 Баланс: {acc.balance}$\nEquity: {acc.equity}$")

@bot.message_handler(func=lambda m: m.text == "📊 Позиции")
def positions(m):
    pos = mt5.positions_get()
    res = "Нет сделок" if not pos else "\n".join([f"{p.symbol} {p.profit}$" for p in pos])
    bot.send_message(m.chat.id, res)

@bot.message_handler(func=lambda m: m.text == "⚠️ ЗАКРЫТЬ ВСЕ")
def close_all(m):
    for p in mt5.positions_get():
        tick = mt5.symbol_info_tick(p.symbol)
        req = {
            "action": mt5.TRADE_ACTION_DEAL, "symbol": p.symbol, "volume": p.volume,
            "type": (mt5.ORDER_TYPE_SELL if p.type == 0 else mt5.ORDER_TYPE_BUY),
            "position": p.ticket, "price": (tick.bid if p.type == 0 else tick.ask),
            "magic": MAGIC, "type_filling": get_filling_mode(p.symbol),
        }
        mt5.order_send(req)
    bot.send_message(m.chat.id, "🛑 Все позиции закрыты.")

@bot.message_handler(func=lambda m: m.text == "⚙️ Режим")
def set_mode(m):
    kb = telebot.types.InlineKeyboardMarkup()
    kb.add(telebot.types.InlineKeyboardButton("🔴 Выкл", callback_data="m_0"),
           telebot.types.InlineKeyboardButton("🔍 Сигналы", callback_data="m_1"),
           telebot.types.InlineKeyboardButton("🤖 Авто", callback_data="m_2"))
    bot.send_message(m.chat.id, "Выбор режима:", reply_markup=kb)

@bot.callback_query_handler(func=lambda call: call.data.startswith("m_"))
def update_mode(call):
    global trading_mode
    trading_mode = int(call.data.split("_")[1])
    bot.answer_callback_query(call.id, f"Режим: {MODES[trading_mode]}")
    bot.send_message(call.message.chat.id, f"✅ Установлен режим: {MODES[trading_mode]}")

if __name__ == "__main__":
    Thread(target=trading_engine, daemon=True).start()
    bot.infinity_polling()
