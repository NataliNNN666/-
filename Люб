TOKEN = "ВАШ_ТОКЕН"
CHAT_ID = "ВАШ_ID"
ACCOUNT = 68313049
PASSWORD = "ВАШ_ПАРОЛЬ"
SERVER = "RoboForex-Pro"

SYMBOLS = {"GOLD": "XAUUSD", "EURUSD": "EURUSD"}
