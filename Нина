import React, { useEffect } from 'react'
import WebApp from '@twa-dev/sdk'
import { motion } from 'framer-motion'
import { ShoppingBag, Zap, Brain, Send, Star } from 'lucide-react'

function App() {
  // ВПИШИ СВОЙ ЛОГИН ТЕЛЕГРАМ НИЖЕ (без символа @)
  const myUsername = "nina_mikhailovna_expert"; 

  const services = [
    { 
      id: 1, title: "🚀 Взрывной CTR", price: "1 000₽", icon: <ShoppingBag />, color: "#FF3366",
      desc: "Карточки для WB/Ozon, которые ГРАБЯТ внимание покупателей. Нейродизайн + маркетинг." 
    },
    { 
      id: 2, title: "🧠 ИИ-Трансформация", price: "3 000₽", icon: <Brain />, color: "#00C2FF",
      desc: "Внедряю нейросети в ваш бизнес. Хватит тратить часы на то, что ИИ делает за секунды." 
    },
    { 
      id: 3, title: "⚡ Магия Контента", price: "500₽", icon: <Zap />, color: "#AD00FF",
      desc: "Сценарии и тексты с душой. Генерирую идеи, которые заставляют людей подписываться." 
    }
  ];

  const works = ["/work1.jpg", "/work2.jpg", "/work3.jpg"];

  useEffect(() => {
    WebApp.ready();
    WebApp.expand(); // Разворачивает приложение на весь экран телефона
  }, []);

  // Легкая вибрация при просмотре кейсов
  const handleWorkClick = () => {
    WebApp.HapticFeedback.impactOccurred('light');
  };

  // Умная вибрация и переход в ЛС при заказе
  const handleOrder = (service) => {
    WebApp.HapticFeedback.impactOccurred('medium');
    setTimeout(() => WebApp.HapticFeedback.notificationOccurred('success'), 200);

    const message = `Привет! Увидел в твоем Mini App услугу "${service.title}". Хочу обсудить детали!`;
    const url = `https://t.me{myUsername}?text=${encodeURIComponent(message)}`;
    WebApp.openTelegramLink(url);
  };

  return (
    <div style={{ background: '#080808', minHeight: '100vh', color: 'white', padding: '20px', fontFamily: 'sans-serif' }}>
      
      {/* 1. ШАПКА: ФОТО И ИМЯ */}
      <motion.header initial={{ opacity: 0, y: -20 }} animate={{ opacity: 1, y: 0 }} style={{ textAlign: 'center', marginBottom: '30px' }}>
        <div style={{ 
          width: '110px', height: '110px', margin: '0 auto 15px', borderRadius: '35px',
          backgroundImage: 'url("/me.jpg")', backgroundSize: 'cover', backgroundPosition: 'center',
          border: '2px solid #333', boxShadow: '0 0 30px rgba(0, 194, 255, 0.3)'
        }} />
        <h1 style={{ fontSize: '26px', margin: '0', fontWeight: '900' }}>AI EXPERT</h1>
      </motion.header>

      {/* 2. БЛОК ОБО МНЕ */}
      <motion.div initial={{ opacity: 0 }} animate={{ opacity: 1 }} transition={{ delay: 0.2 }}
        style={{ background: 'rgba(255,255,255,0.05)', borderRadius: '20px', padding: '15px', marginBottom: '30px', borderLeft: '4px solid #00C2FF' }}>
        <p style={{ fontSize: '14px', lineHeight: '1.6', margin: 0, color: '#ccc' }}>
          Опытный специалист по работе с нейросетями — делюсь практикой и готовыми решениями. 
          Создаю продающие карточки для маркетплейсов и помогаю внедрять ИИ в повседневные задачи.
        </p>
      </motion.div>

      {/* 3. ГАЛЕРЕЯ: КЕЙСЫ */}
      <div style={{ marginBottom: '40px' }}>
        <h3 style={{ fontSize: '18px', display: 'flex', alignItems: 'center', gap: '8px', marginBottom: '15px' }}>
          <Star size={18} color="#FFD700" /> Мои работы
        </h3>
        <div style={{ display: 'flex', overflowX: 'auto', gap: '15px', paddingBottom: '10px', scrollbarWidth: 'none' }}>
          {works.map((src, i) => (
            <motion.div key={i} onClick={handleWorkClick} whileTap={{ scale: 0.9 }} style={{ 
              minWidth: '150px', height: '200px', borderRadius: '25px',
              backgroundImage: `url(${src})`, backgroundSize: 'cover', backgroundPosition: 'center',
              border: '1px solid rgba(255,255,255,0.1)'
            }} />
          ))}
        </div>
      </div>

      {/* 4. СПИСОК УСЛУГ */}
      <div style={{ display: 'grid', gap: '15px' }}>
        {services.map((s) => (
          <motion.div
            key={s.id}
            whileTap={{ scale: 0.97 }}
            onClick={() => handleOrder(s)}
            style={{
              background: 'rgba(255,255,255,0.03)', backdropFilter: 'blur(10px)',
              borderRadius: '28px', padding: '20px', border: '1px solid rgba(255,255,255,0.08)',
              display: 'flex', gap: '15px', alignItems: 'start'
            }}
          >
            <div style={{ background: s.color, padding: '12px', borderRadius: '18px', color: 'white' }}>{s.icon}</div>
            <div style={{ flex: 1 }}>
              <div style={{ fontWeight: '900', fontSize: '18px', color: s.color }}>{s.title}</div>
              <div style={{ fontSize: '13px', color: '#aaa', marginTop: '4px', lineHeight: '1.4' }}>{s.desc}</div>
              <div style={{ marginTop: '10px', fontWeight: 'bold', display: 'flex', justifyContent: 'space-between', alignItems: 'center' }}>
                {s.price} <Send size={16} opacity={0.5} />
              </div>
            </div>
          </motion.div>
        ))}
      </div>

    </div>
  );
}

export default App;
