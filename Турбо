# ================= МОДУЛЬ ИИ (Random Forest) =================

def train_ai():
    global model
    if not os.path.exists(MEMORY_FILE): return
    try:
        df = pd.read_csv(MEMORY_FILE).dropna()
        if len(df) < 150: return # Ждем накопления базы

        X = df[FEATURES]
        # Цель: цена через 3 свечи (15 мин) станет выше текущей?
        y = (df['close'].shift(-3) > df['close']).astype(int)
        
        model = RandomForestClassifier(n_estimators=100, max_depth=8, random_state=42)
        model.fit(X[:-3], y[:-3])
        joblib.dump(model, MODEL_FILE)
        print("--- [ИИ]: Модель успешно обновлена на новых данных! ---")
    except Exception as e:
        print(f"Ошибка обучения ИИ: {e}")

def load_ai():
    global model
    if os.path.exists(MODEL_FILE):
        model = joblib.load(MODEL_FILE)
        print("--- [ИИ]: Модель загружена и готова к фильтрации ---")

# ================= ВИЗУАЛИЗАЦИЯ И ТОРГОВЛЯ =================

def get_filling_mode(symbol):
    s_info = mt5.symbol_info(symbol)
    if s_info.filling_mode & mt5.ORDER_FILLING_IOC: return mt5.ORDER_FILLING_IOC
    if s_info.filling_mode & mt5.ORDER_FILLING_FOK: return mt5.ORDER_FILLING_FOK
    return mt5.ORDER_FILLING_RETURN

def send_signal_chart(symbol, side, price, reason):
    rates = mt5.copy_rates_from_pos(symbol, mt5.TIMEFRAME_M5, 0, 40)
    if rates is None: return
    df = pd.DataFrame(rates)
    plt.figure(figsize=(10, 5))
    plt.plot(df['close'], color='#1f77b4', label='Цена')
    plt.axhline(y=price, color=('green' if side == "BUY" else 'red'), linestyle='--')
    plt.title(f"{symbol} | {side} | AI CONFIRMED")
    plt.grid(True, alpha=0.3)
    
    path = f"signal_{symbol}.png"
    plt.savefig(path)
    plt.close()
    
    with open(path, 'rb') as f:
        msg = f"🚀 **НОВАЯ СДЕЛКА: {side}**\n\n🔹 Актив: {symbol}\n🔹 Цена: {price}\n\n💬 **Мысли ИИ:** _{reason}_"
        bot.send_photo(CHAT_ID, f, caption=msg, parse_mode="Markdown")
    if os.path.exists(path): os.remove(path)

def open_trade(symbol, side, last_data):
    tick = mt5.symbol_info_tick(symbol)
    price = tick.ask if side == "BUY" else tick.bid
    atr = last_data['ATR']
    
    # Расчет SL и TP
    sl = price - (atr * 2.5) if side == "BUY" else price + (atr * 2.5)
    tp = price + (atr * 3.5) if side == "BUY" else price - (atr * 3.5)

    request = {
        "action": mt5.TRADE_ACTION_DEAL,
        "symbol": symbol,
        "volume": LOT,
        "type": mt5.ORDER_TYPE_BUY if side == "BUY" else mt5.ORDER_TYPE_SELL,
        "price": price, "sl": sl, "tp": tp,
        "magic": MAGIC, "comment": "PRO_AI_V3",
        "type_filling": get_filling_mode(symbol),
        "type_time": mt5.ORDER_TIME_GTC,
    }
    
    res = mt5.order_send(request)
    if res.retcode == mt5.TRADE_RETCODE_DONE:
        reasons = {
            "BUY": "Вижу сильную поддержку и одобрение нейросети. Вхожу в лонг.",
            "SELL": "Тренд ослаб, ИИ подтверждает давление медведей. Открываю шорт."
        }
        send_signal_chart(symbol, side, price, reasons[side])
    else:
        print(f"Ошибка MT5: {res.comment}")

