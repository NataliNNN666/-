# ================= ОСНОВНОЙ ДВИЖОК =================

def trading_engine():
    if not mt5.initialize(): return
    mt5.login(ACCOUNT, PASSWORD, SERVER)
    load_ai()
    
    last_train_time = time.time()

    while True:
        # Авто-обучение раз в 2 часа
        if time.time() - last_train_time > 7200:
            train_ai()
            last_train_time = time.time()

        if trading_mode == 2:
            for _, symbol in SYMBOLS.items():
                try:
                    if mt5.positions_get(symbol=symbol): continue
                    
                    rates = mt5.copy_rates_from_pos(symbol, mt5.TIMEFRAME_M5, 0, 200)
                    if rates is None: continue
                    
                    df = pd.DataFrame(rates)
                    # Рассчитываем индикаторы через pandas_ta
                    df['RSI'] = ta.rsi(df['close'], length=14)
                    df['EMA_9'] = ta.ema(df['close'], length=9)
                    df['SMA_200'] = ta.sma(df['close'], length=200)
                    df['ATR'] = ta.atr(df['high'], df['low'], df['close'], length=14)
                    
                    macd = ta.macd(df['close'])
                    stoch = ta.stoch(df['high'], df['low'], df['close'])
                    df['MACD'] = macd.iloc[:, 0]
                    df['STOCH_K'] = stoch.iloc[:, 0]
                    df.dropna(inplace=True)
                    
                    last = df.iloc[-1]
                    
                    # Запись в память для ИИ
                    last_row = last[FEATURES + ['close']].to_frame().T
                    last_row.to_csv(MEMORY_FILE, mode='a', header=not os.path.exists(MEMORY_FILE), index=False)

                    # --- ЛОГИКА СИГНАЛА ---
                    side = None
                    if last['close'] > last['SMA_200'] and last['RSI'] < 40 and last['STOCH_K'] < 30:
                        side = "BUY"
                    elif last['close'] < last['SMA_200'] and last['RSI'] > 60 and last['STOCH_K'] > 70:
                        side = "SELL"

                    # --- ИИ-ФИЛЬТР ---
                    if side and model:
                        pred_data = last[FEATURES].values.reshape(1, -1)
                        prob = model.predict_proba(pred_data)[0][1] # Вероятность роста
                        
                        # Если BUY и ИИ сомневается ИЛИ если SELL и ИИ видит рост
                        if side == "BUY" and prob < 0.55: side = None
                        if side == "SELL" and prob > 0.45: side = None

                    if side:
                        open_trade(symbol, side, last)
                            
                except Exception as e:
                    print(f"Ошибка тика {symbol}: {e}")
        
        time.sleep(60)

if __name__ == "__main__":
    Thread(target=trading_engine, daemon=True).start()
    print(">>> БОТ ЗАПУЩЕН И ГОТОВ К РАБОТЕ")
    bot.infinity_polling()
